# ── Core ────────────────────────────────────────────────────────────────────
# Postgres connection string. For local dev with docker-compose:
#   postgresql://saas:saas@localhost:5432/saas_starter
DATABASE_URL=postgresql://saas:saas@localhost:5432/saas_starter

# The public base URL of the app. Used to build links in emails
# (verify email, password reset, invitations). No trailing slash.
APP_URL=http://localhost:3000

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Any SMTP server works (your own postfix, Mailpit for dev, Mailgun, etc).
# In development, if SMTP_HOST is empty, emails are printed to the server
# console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="SaaS Starter <no-reply@example.com>"

# ── Notes ───────────────────────────────────────────────────────────────────
# NODE_ENV is set by the runtime (next start / Docker); do not set it here.
# Copy this file to .env for local development:  cp .env.example .env
