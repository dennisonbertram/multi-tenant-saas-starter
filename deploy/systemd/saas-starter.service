[Unit]
Description=SaaS Starter (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

# Bare-metal deployment with systemd. Assumes:
#   - app lives in /opt/saas-starter (built with `npm run build`)
#   - a dedicated user `saas` owns it
#   - PostgreSQL runs locally (or tweak After= for remote DB)
# Install:
#   sudo cp deploy/systemd/saas-starter.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now saas-starter

[Service]
Type=simple
User=saas
Group=saas
WorkingDirectory=/opt/saas-starter
EnvironmentFile=/opt/saas-starter/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Run migrations before (re)starting the server; idempotent.
ExecStartPre=/usr/bin/env npm run db:migrate
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/saas-starter

[Install]
WantedBy=multi-user.target
